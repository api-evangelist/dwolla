          "id": "de2c8f62-2a9e-4ac0-bc85-6ef212e96ebc",
          "name": "Create an application access token",
          "request": {
            "name": "Create an application access token",
            "description": {
              "content": "Generate an application access token using OAuth 2.0 client credentials flow for server-to-server authentication. Requires client ID and secret sent via Basic authentication header with grant_type=client_credentials in the request body. Returns a bearer access token with expiration time for authenticating API requests scoped to your application. Essential for secure API access.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "token"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "disabled": false,
                  "key": "grant_type",
                  "value": "<string>",
                  "description": "(Required) Must be set to \"client_credentials\""
                }
              ]
            }
          },
          "response": [
