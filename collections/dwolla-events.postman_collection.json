          "name": "List events",
          "request": {
            "name": "List events",
            "description": {
              "content": "Returns a paginated list of events representing state changes to resources in your Dwolla application. Events track actions on customers, transfers, funding sources, and other resources, sorted by creation date (newest first). Events are retained for 30 days and are essential for webhook notifications and system activity monitoring.",
              "type": "text/plain"
            },
            "url": {
