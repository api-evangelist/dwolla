                    "body": {
                      "mode": "raw",
                      "raw": "{\n  \"_links\": {\n    \"exchange-partner\": {\n      \"href\": \"<uri>\"\n    },\n    \"redirect-url\": {\n      \"href\": \"<uri>\"\n    }\n  }\n}",
