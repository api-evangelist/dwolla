      "name": "exchange-sessions",
      "item": [
        {
          "name": "{id}",
          "item": [
            {
              "name": "Retrieve exchange session",
              "id": "ec923da3-0411-46e9-b6fa-88d89367e7cb",
              "protocolProfileBehavior": {
                "disableBodyPruning": true
              },
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/vnd.dwolla.v1.hal+json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/exchange-sessions/:id",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "exchange-sessions",
                    ":id"
                  ],
                  "variable": [
                    {
                      "id": "5a7e10db-6d08-424f-b9d8-4d8de328d83b",
                      "key": "id",
                      "value": "<string>",
                      "description": "(Required) Exchange session's unique identifier"
                    }
                  ]
                },
                "description": "Returns details of a previously created exchange session. Response varies by partner:\n- **MX**: `_links.external-provider-session.href` (redirect URL for verification).\n- **Plaid**: `externalProviderSessionToken` (token to initialize Plaid Link).\n- **Checkout.com**: `externalProviderSessionData` with `id`, `payment_session_secret`, and `payment_session_token` to initialize the Checkout.com Flow component for debit card capture (Push to Card).\n"
              },
