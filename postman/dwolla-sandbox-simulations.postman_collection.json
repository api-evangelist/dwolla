                  "options": {
                    "raw": {
                      "headerFamily": "json",
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{baseUrl}}/sandbox-simulations",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "sandbox-simulations"
                  ]
                }
